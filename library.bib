@article{vonder_haar_c._repetitive_2019,
	title = {Repetitive closed-head impact model of engineered rotational acceleration ({CHIMERA}) injury in rats increases impulsivity, decreases dopaminergic innervation in the olfactory tubercle and generates white matter inflammation, tau phosphorylation and degeneration},
	volume = {317},
	issn = {0014-4886},
	url = {http://www.elsevier.com/inca/publications/store/6/2/2/8/2/8/index.htt},
	doi = {10.1016/j.expneurol.2019.02.012},
	abstract = {Traumatic brain injury (TBI) affects at least 3 M people annually. In humans, repetitive mild TBI (rmTBI) can lead to increased impulsivity and may be associated with chronic traumatic encephalopathy. To better understand the relationship between repetitive TBI (rTBI), impulsivity and neuropathology, we used CHIMERA (Closed-Head Injury Model of Engineered Rotational Acceleration) to deliver five TBIs to rats, which were continuously assessed for trait impulsivity using the delay discounting task and for neuropathology at endpoint. Compared to sham controls, rats with rTBI displayed progressive impairment in impulsive choice. Histological analyses revealed reduced dopaminergic innervation from the ventral tegmental area to the olfactory tubercle, consistent with altered impulsivity neurocircuitry. Consistent with diffuse axonal injury generated by CHIMERA, white matter inflammation, tau immunoreactivity and degeneration were observed in the optic tract and corpus callosum. Finally, pronounced grey matter microgliosis was observed in the olfactory tubercle. Our results provide insight into the mechanisms by which rTBI leads to post-traumatic psychiatric-like symptoms in a novel rat TBI platform.Copyright © 2019},
	language = {English},
	number = {(Vonder Haar, Martens) Injury and Recovery Laboratory, Department of Psychology, West Virginia University, Morgantown, WV 26508, United States},
	journal = {Experimental Neurology},
	author = {{Vonder Haar C.} and {Martens K.M.} and {Bashir A.} and {McInnes K.A.} and {Cheng W.H.} and {Cheung H.} and {Stukas S.} and {Barron C.} and {Ladner T.} and {Welch K.A.} and {Cripton P.A.} and {Winstanley C.A.} and {Wellington C.L.}},
	year = {2019},
	keywords = {Male, Animals, Rats, histopathology, animal experiment, animal model, animal tissue, article, controlled study, gray matter, microglia, nonhuman, priority journal, rat, Disease Models, Animal, male, corpus callosum, *traumatic brain injury, Corpus Callosum/pathology, disease exacerbation, gliosis, immunoreactivity, diffuse axonal injury, glial fibrillary acidic protein/ec [Endogenous Compound], neuropathology, optic tract, *CHIMERA, Axons/pathology, *tau protein/ec [Endogenous Compound], neurofilament protein/ec [Endogenous Compound], righting reflex, White Matter/*pathology, Gliosis/pathology, Rats, Long-Evans, tau Proteins/*metabolism, *white matter injury, basolateral amygdala, *nerve degeneration, brain homogenate, task performance, latent period, *acceleration, *autonomic innervation, *closed head injury model of engineered rotational acceleration, *Corpus callosum degeneration, *dopaminergic system, *Impulsivity, *olfactory tubercle, *protein phosphorylation, *Repetitive TBI, *Reward circuitry, *Tau phosphorylation, *White matter inflammation, allograft inflammatory factor 1/ec [Endogenous Compound], biochemical analysis, brain degeneration, Choice Behavior, decision making, delay discounting, dopamine brain level, Dopaminergic Neurons/*pathology, Head Injuries, Closed/*pathology/psychology, impulsiveness, Inflammation/*pathology, limbic cortex, mesencephalon, morbidity, mortality rate, nerve conduction, Neurodegenerative Diseases/etiology/pathology, nucleus accumbens, Olfactory Tubercle/*pathology, orbital cortex, Phosphorylation, protein depletion, reward, Reward, Tauopathies/pathology, ventral tegmentum},
