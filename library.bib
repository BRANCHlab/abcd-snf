	keywords = {Adolescent, Brain Concussion, Child, Female, Humans, Male, Young Adult, Anisotropy, Attention Deficit Disorder with Hyperactivity, Attention-deficit/hyperactivity disorder, Basal Ganglia, Case-Control Studies, Corpus Callosum, Diffusion tensor imaging, Diffusion Tensor Imaging, Magnetic resonance imaging, Multifactorial Inheritance, Neuroimaging, Polygenic score, Severity of Illness Index, Traumatic brain injury, White Matter, Youths},
