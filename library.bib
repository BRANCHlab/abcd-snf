	year = {2020},
	pmid = {33679599},
	pmcid = {PMC7930488},
	keywords = {Adolescent, Child, Female, Humans, Male, Self Report, Adolescent Development, adolescent brain cognitive development, Child Development, Cross-Sectional Studies, dehydroepiandrosterone, Dehydroepiandrosterone, estradiol, Estradiol, Gonadal Steroid Hormones, pubertal development scale, puberty, Puberty, salivary hormones, Sexual Maturation, Socioeconomic Factors, testosterone, Testosterone},
