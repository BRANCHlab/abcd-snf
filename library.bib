}

@article{kooijman_e._long-term_2014,
	title = {Long-term functional consequences and ongoing cerebral inflammation after subarachnoid hemorrhage in the rat},
	volume = {9},
	issn = {1932-6203 (electronic)},
	url = {http://www.plosone.org/article/fetchObject.action?uri=info%3Adoi%2F10.1371%2Fjournal.pone.0090584&representation=PDF},
	doi = {10.1371/journal.pone.0090584},
	abstract = {Subarachnoid hemorrhage (SAH) represents a considerable health problem with an incidence of 6-7 per 100.000 individuals per year in Western society. We investigated the long-term consequences of SAH on behavior, neuroinflammation and gray-and white-matter damage using an endovascular puncture model in Wistar rats. Rats were divided into a mild or severe SAH group based on their acute neurological score at 24 h post-SAH. The degree of hemorrhage determined in post-mortem brains at 48 h strongly correlated with the acute neurological score. Severe SAH induced increased TNF-alpha, IL-1beta, IL-10, MCP- 1, MIP2, CINC-1 mRNA expression and cortical neutrophil influx at 48 h post-insult. Neuroinflammation after SAH was very long-lasting and still present at day 21 as determined by Iba-1 staining (microglia/macrophages) and GFAP (astrocytes). Long-term neuroinflammation was strongly associated with the degree of severity of SAH. Cerebral damage to gray- and white-matter was visualized by immunohistochemistry for MAP2 and MBP at 21 days after SAH. Severe SAH induced significant gray- and white-matter damage. MAP2 loss at day 21 correlated significantly with the acute neurological score determined at 24 h post-SAH. Sensorimotor behavior, determined by the adhesive removal task and von Frey test, was affected after severe SAH at day 21. In conclusion, we are the first to show that SAH induces ongoing cortical inflammation. Moreover, SAH induces mainly cortical long-term brain damage, which is associated with long-term sensorimotor damage. © 2014 Kooijman et al.},
	language = {English},
	number = {3},
	journal = {PLoS ONE},
	author = {{Kooijman E.} and {Nijboer C.H.} and {Van Velthoven C.T.J.} and {Mol W.} and {Dijkhuizen R.M.} and {Kesecioglu J.} and {Heijnen C.J.}},
	year = {2014},
	keywords = {Male, Recovery of Function, gene expression, Animals, animal experiment, animal model, animal tissue, article, controlled study, disease severity, gray matter, nonhuman, rat, white matter, Rats, Wistar, male, neutrophil chemotaxis, adult, glial fibrillary acidic protein/ec [Endogenous Compound], myelin basic protein/ec [Endogenous Compound], nervous system inflammation/co [Complication], calcium binding protein/ec [Endogenous Compound], unclassified drug, interleukin 10/ec [Endogenous Compound], sensorimotor function, interleukin 1beta/ec [Endogenous Compound], tumor necrosis factor-alpha/ec [Endogenous Compound], microtubule associated protein 2/ec [Endogenous Compound], behavior, *encephalitis/co [Complication], *subarachnoid hemorrhage, Brain Damage, Chronic/immunology, brain damage/co [Complication], Cerebral Cortex/immunology/*pathology, cytokine induced neutrophil chemoattractant/ec [Endogenous Compound], Encephalitis/immunology/*physiopathology, macrophage inflammatory protein 2/ec [Endogenous Compound], Macrophages/immunology, monocyte chemotactic protein 1/ec [Endogenous Compound], Neutrophils/immunology, prognosis, protein CINC 1/ec [Endogenous Compound], protein Iba 1/ec [Endogenous Compound], Psychomotor Disorders/immunology, Subarachnoid Hemorrhage/immunology/*physiopathology},
